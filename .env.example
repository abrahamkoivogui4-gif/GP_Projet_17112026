# Connexion PostgreSQL
DATABASE_URL=postgres://gp:gp@localhost:5432/gp

# Compte administrateur créé au démarrage (changez le mot de passe !)
ADMIN_NAME=Administrateur
ADMIN_PHONE=+33600000000
ADMIN_PASSWORD=changez-moi-svp

# Dossier où sont stockées les pièces d'identité (privé, jamais servi publiquement)
UPLOAD_DIR=./data/uploads

# URL publique du site (utilisée dans les liens de partage)
APP_URL=http://localhost:3000

# Notifications WhatsApp (API WhatsApp Business de Meta). Vide = messages écrits dans les logs seulement.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NEW_TRIP=nouveau_trajet
WHATSAPP_TEMPLATE_NOTIFICATION=
