# Copiez ce fichier en .env sur le serveur et remplissez chaque valeur.
DOMAIN=kola.example.com
POSTGRES_PASSWORD=un-long-mot-de-passe-aleatoire
ADMIN_NAME=Administrateur
ADMIN_PHONE=+33600000000
ADMIN_PASSWORD=un-autre-mot-de-passe-solide

# Envoi d'e-mails aux GP (voir le README). Exemple avec une boîte mail OVH :
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@lilalink.fr
SMTP_PASS=mot-de-passe-de-la-boite
MAIL_FROM=Lilalink <contact@lilalink.fr>

# Mentions légales et contact (affichés sur /mentions-legales, /cgu, /confidentialite, /contact)
LEGAL_NAME=Prénom Nom (ou nom de la société)
LEGAL_FORM=Entrepreneur individuel
LEGAL_ADDRESS=1 rue Exemple, 75000 Paris
LEGAL_SIRET=123 456 789 00012
PUBLICATION_DIRECTOR=Prénom Nom
CONTACT_EMAIL=contact@lilalink.fr

# Réseaux sociaux (liens complets en https://). Laissez vide pour masquer.
SOCIAL_FACEBOOK=https://www.facebook.com/votre-page
SOCIAL_TIKTOK=https://www.tiktok.com/@votre-compte
# WhatsApp : lien de votre chaîne, groupe ou numéro (https://wa.me/33612345678)
SOCIAL_WHATSAPP=https://wa.me/33612345678
