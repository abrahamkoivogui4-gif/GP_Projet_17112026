# Caddy obtient et renouvelle automatiquement le certificat HTTPS pour votre domaine.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# Redirige www vers le domaine principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Sites supplémentaires hébergés sur ce serveur (ex. Business Hub) : un fichier .caddy par site dans caddy-extra/
import /etc/caddy/extra/*.caddy
